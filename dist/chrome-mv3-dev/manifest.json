{
  "manifest_version": 3,
  "name": "__MSG_EXTENSION_NAME__",
  "description": "__MSG_EXTENSION_DESCRIPTION__",
  "version": "1.0.0",
  "icons": {
    "16": "icon/16.png",
    "32": "icon/32.png",
    "48": "icon/48.png",
    "96": "icon/96.png",
    "128": "icon/128.png"
  },
  "optional_host_permissions": [
    "*://*/*"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "http://localhost/*"
  ],
  "permissions": [
    "storage",
    "tabs",
    "unlimitedStorage",
    "userScripts",
    "scripting"
  ],
  "default_locale": "en",
  "commands": {
    "wxt:reload-extension": {
      "description": "Reload the extension during development",
      "suggested_key": {
        "default": "Alt+R"
      }
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "User Javascript and CSS",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "open_in_tab": true,
    "page": "options.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval' http://localhost:3000; object-src 'self';",
    "sandbox": "script-src 'self' 'unsafe-inline' 'unsafe-eval' http://localhost:3000; sandbox allow-scripts allow-forms allow-popups allow-modals; child-src 'self';"
  }
}